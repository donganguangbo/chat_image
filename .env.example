# Required by go-gateway.
GATEWAY_SECRET=replace-with-a-long-random-secret
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Linode object storage. These defaults match app/configs/service.yaml.
S3_ENDPOINT=us-ord-10.linodeobjects.com
S3_REGION=us-ord-10
S3_BUCKET=ichat

# Host paths and published interfaces.
OUTPUT_HOST_DIR=/root/autodl-fs
GO_BIND_ADDR=0.0.0.0
COMFY_BIND_ADDR=0.0.0.0

# llama.cpp model files under models/llama.
LLAMA_MODEL_FILE=Qwen3.6-35B-A3B-Uncensored-HauhauCS-Aggressive-Q4_K_M.gguf
LLAMA_MMPROJ_FILE=mmproj-Qwen3.6-35B-A3B-Uncensored-HauhauCS-Aggressive-f16.gguf
LLAMA_CTX_SIZE=16384
LLAMA_NGL=999
TEXT_MODEL=qwen-local

# Override these only when the registry tag needs to be pinned or changed.
LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
COMFY_CUDA_IMAGE=nvidia/cuda:13.0.2-cudnn-devel-ubuntu24.04
